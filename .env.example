# Optional cwd/.env loading; real process environment takes precedence.
ADVISOR_STORAGE_BACKEND=sqlite
# Required only when ADVISOR_STORAGE_BACKEND=postgres. Never commit a real URL.
ADVISOR_DATABASE_URL=

COINGECKO_API_KEY=
COINGECKO_API_TIER=demo
MARKET_DATA_TIMEOUT_SECONDS=10

# Optional AI. Disabled by default; never commit your real key.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=45

# Foreground UTC 4H scheduler. `scheduler once` works even when disabled.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_HOURS=4
SCHEDULER_CANDLE_DELAY_MINUTES=10
SCHEDULER_MAX_STARTUP_CATCHUP_AGE_MINUTES=30

# Outbound Telegram delivery. Keep real credentials only in ignored .env or process environment.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_DISABLE_NOTIFICATION=false
