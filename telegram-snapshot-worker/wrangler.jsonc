{
  "name": "telegram-snapshot-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "routes": [],
  "vars": {
    "GITHUB_OWNER": "KlinovK",
    "GITHUB_REPOSITORY": "advancedTradingAdvisor",
    "GITHUB_WORKFLOW": "binance-on-demand-snapshot.yml",
    "ALLOWED_TELEGRAM_USER_ID": "REPLACE_WITH_USER_ID",
    "ALLOWED_TELEGRAM_CHAT_ID": "REPLACE_WITH_CHAT_ID",
    "COOLDOWN_SECONDS": "600",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SNAPSHOT_COORDINATOR",
        "class_name": "SnapshotCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SnapshotCoordinator"],
    },
  ],
}
